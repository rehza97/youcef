# ============================================================================
# Youcef Project - Environment Variables
#
# SETUP INSTRUCTIONS:
# 1. Copy the .env file from secure storage (it's in the repo, already configured)
# 2. For first-time setup or new VPS, use: cp .env.example .env
# 3. Update values below with your environment-specific settings
# ============================================================================

# Database Password
# IMPORTANT: Use a strong password in production (min 20 chars, mix of upper/lower/numbers/symbols)
# This should be set from secure storage, not committed to git
DB_PASSWORD=CHANGE_ME_IN_PRODUCTION

# Backend Secret Key (for JWT token signing)
# IMPORTANT: Use a long, random string in production
# This should be set from secure storage, not committed to git
SECRET_KEY=CHANGE_ME_IN_PRODUCTION

# Debug Mode (false in production, true in development)
DEBUG=false

# CORS Origins (comma-separated, allowed frontend domains)
# Update with your actual domain
CORS_ORIGINS=http://localhost:3000,http://194.146.13.22:3000

# Frontend API URL (what the browser uses to call backend)
VITE_API_URL=http://194.146.13.22:8001

# Auto-update settings
AUTO_GIT_UPDATE=false
GIT_BRANCH=fastapi_v1
